function viewProducts(){
  const s = app.state;
  let list = s.products.filter(p=>{
    const q = s.prodSearch.trim().toLowerCase();
    if(!q) return true;
    return (p.name||'').toLowerCase().includes(q) || (p.id||'').toLowerCase().includes(q) || (p.category||'').toLowerCase().includes(q);
  });
  if(s.prodFilter==='available') list = list.filter(p=>p.status==='Available');
  else if(s.prodFilter==='lowstock') list = list.filter(p=>p.status==='Low Stock');
  else if(s.prodFilter==='outofstock') list = list.filter(p=>p.status==='Out of Stock');
  else if(s.prodFilter==='bestselling'){
