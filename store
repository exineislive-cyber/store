function lineItemRow(it, i, prodOptionsFor){
  return `
  <div class="line-item-row" data-idx="${i}">
    <div class="field-group" style="margin-bottom:0;"><label class="field-label">${i===0?'Product':''}</label>
      <select class="field-input line-product" onchange="handlers.lineProductChange(this)">
        <option value="">— select —</option>
        ${prodOptionsFor(it.productId)}
      </select>
    </div>
    <div class="field-group" style="margin-bottom:0;"><label class="field-label">${i===0?'Qty':''}</label><input class="field-input line-qty" type="number" min="1" value="${it.qty||1}" oninput="orderCalc()"></div>
    <div class="field-group" style="margin-bottom:0;"><label class="field-label">${i===0?'Price (₹)':''}</label><input class="field-input line-price" type="number" min="0" value="${it.price||0}" oninput="orderCalc()"></div>
    <div class="field-group" style="margin-bottom:0;"><label class="field-label">${i===0?'Line total':''}</label><input class="field-input line-total" value="${money((it.qty||0)*(it.price||0))}" disabled></div>
    <button type="button" class="icon-btn" style="margin-bottom:1px;" onclick="handlers.removeLineItem(this)">${icon('x')}</button>
  </div>`;
}
function orderCalc(){
  const rows = document.querySelectorAll('#lineItems .line-item-row');
  let itemsSum = 0;
  rows.forEach(r=>{
    const qty = Number(r.querySelector('.line-qty').value)||0;
    const price = Number(r.querySelector('.line-price').value)||0;
    r.querySelector('.line-total').value = money(qty*price);
    itemsSum += qty*price;
  });
  const form = rows[0]?.closest('form');
  if(!form) return;
  const discount = Number(form.discount.value)||0;
  const delivery = Number(form.deliveryCharge.value)||0;
  const total = Math.max(0, itemsSum - discount + delivery);
  document.getElementById('ordTotal').value = money(total);

  const payStatus = document.getElementById('ordPayStatus').value;
  const paidInput = document.getElementById('ordAmountPaid');
  if(payStatus==='Paid') paidInput.value = total;
  if(payStatus==='Unpaid') paidInput.value = 0;
  const paid = Number(paidInput.value)||0;
  document.getElementById('ordAmountRemaining').value = money(Math.max(0,total-paid));
}

