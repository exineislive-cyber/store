<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ledger — Store Command</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#141019;
  --bg-2:#1b1624;
  --panel:rgba(255,255,255,0.045);
  --panel-solid:#1f1a29;
  --border:rgba(255,255,255,0.09);
  --border-soft:rgba(255,255,255,0.06);
  --text:#f2eef8;
  --text-dim:#b6acc9;
  --text-faint:#7c7291;
  --purple:#9d5cff;
  --pink:#ef4b9e;
  --amber:#f7b955;
  --grad:linear-gradient(135deg,#7c3aed 0%,#ec4899 55%,#f7b955 100%);
  --success:#3ddc97;
  --warning:#f7b955;
  --danger:#f2596b;
  --info:#5bb4f2;
  --radius-lg:22px;
  --radius-md:14px;
  --radius-sm:9px;
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  background:
    radial-gradient(1100px 600px at 85% -10%, rgba(124,58,237,0.22), transparent 60%),
    radial-gradient(900px 500px at -10% 10%, rgba(239,75,158,0.14), transparent 55%),
    var(--bg);
  color:var(--text);
  font-family:'Manrope',sans-serif;
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.serif{font-family:'Fraunces',serif;}
::selection{background:rgba(157,92,255,0.35);}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
input,select,textarea{font-family:inherit;}
::-webkit-scrollbar{width:9px;height:9px;}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,0.14);border-radius:8px;}
::-webkit-scrollbar-track{background:transparent;}

.field-input{
  width:100%;
  background:rgba(0,0,0,0.22);
  border:1px solid var(--border);
  color:var(--text);
  padding:11px 13px;
  border-radius:var(--radius-sm);
  font-size:14px;
  outline:none;
  transition:border-color .15s, box-shadow .15s;
}
.field-input:focus{border-color:var(--purple);box-shadow:0 0 0 3px rgba(157,92,255,0.18);}
.field-input::placeholder{color:var(--text-faint);}
textarea.field-input{resize:vertical;min-height:70px;}
label.field-label{font-size:12px;color:var(--text-dim);font-weight:600;display:block;margin-bottom:6px;letter-spacing:.01em;}
.field-group{margin-bottom:14px;}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.field-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
@media(max-width:640px){.field-row,.field-row3{grid-template-columns:1fr;}}

.btn{
  border:none;border-radius:11px;padding:11px 18px;font-weight:700;font-size:14px;
  display:inline-flex;align-items:center;gap:8px;transition:transform .12s, filter .15s, box-shadow .15s;
}
.btn:active{transform:scale(0.97);}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 6px 20px -6px rgba(157,92,255,0.55);}
.btn-primary:hover{filter:brightness(1.08);}
.btn-ghost{background:rgba(255,255,255,0.06);color:var(--text);border:1px solid var(--border);}
.btn-ghost:hover{background:rgba(255,255,255,0.1);}
.btn-danger{background:rgba(242,89,107,0.14);color:#ff9caa;border:1px solid rgba(242,89,107,0.35);}
.btn-danger:hover{background:rgba(242,89,107,0.22);}
.btn-sm{padding:7px 12px;font-size:12.5px;border-radius:8px;}
.btn:disabled{opacity:.45;cursor:not-allowed;}

.card{
  background:var(--panel);
  border:1px solid var(--border-soft);
  border-radius:var(--radius-lg);
  backdrop-filter:blur(18px);
}
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 11px;border-radius:99px;font-size:12px;font-weight:700;letter-spacing:.01em;white-space:nowrap;}
.dot{width:6px;height:6px;border-radius:50%;background:currentColor;}

/* status colors */
.st-paid{color:var(--success);background:rgba(61,220,151,0.12);}
.st-partial{color:var(--warning);background:rgba(247,185,85,0.14);}
.st-unpaid{color:var(--danger);background:rgba(242,89,107,0.13);}
.st-refunded{color:var(--info);background:rgba(91,180,242,0.13);}
.st-new{color:var(--info);background:rgba(91,180,242,0.13);}
.st-confirmed{color:#a78bfa;background:rgba(167,139,250,0.14);}
.st-processing{color:var(--amber);background:rgba(247,185,85,0.14);}
.st-shipped{color:#7dd3fc;background:rgba(125,211,252,0.13);}
.st-outfordelivery{color:#facc15;background:rgba(250,204,21,0.13);}
.st-delivered{color:var(--success);background:rgba(61,220,151,0.12);}
.st-cancelled{color:var(--danger);background:rgba(242,89,107,0.13);}
.st-returned{color:#f472b6;background:rgba(244,114,182,0.13);}
.st-available{color:var(--success);background:rgba(61,220,151,0.12);}
.st-lowstock{color:var(--warning);background:rgba(247,185,85,0.14);}
.st-outofstock{color:var(--danger);background:rgba(242,89,107,0.13);}
.st-discontinued{color:var(--text-faint);background:rgba(255,255,255,0.06);}

#app{min-height:100vh;}

/* ---- shell layout ---- */
.shell{display:grid;grid-template-columns:236px 1fr;min-height:100vh;}
@media(max-width:900px){.shell{grid-template-columns:1fr;}.sidebar{display:none;}.sidebar.open{display:flex;position:fixed;z-index:50;height:100vh;}}
.sidebar{
  border-right:1px solid var(--border-soft);
  background:rgba(255,255,255,0.02);
  padding:22px 16px;display:flex;flex-direction:column;gap:4px;
}
.brand{display:flex;align-items:center;gap:10px;padding:4px 8px 22px;}
.brand-mark{width:34px;height:34px;border-radius:10px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-weight:600;font-size:17px;color:#fff;flex-shrink:0;}
.brand-name{font-family:'Fraunces',serif;font-size:18px;font-weight:600;}
.brand-sub{font-size:10.5px;color:var(--text-faint);letter-spacing:.06em;}
.nav-item{
  display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:11px;
  color:var(--text-dim);font-size:14px;font-weight:600;transition:background .15s,color .15s;
}
.nav-item svg{width:17px;height:17px;flex-shrink:0;}
.nav-item:hover{background:rgba(255,255,255,0.05);color:var(--text);}
.nav-item.active{background:rgba(157,92,255,0.14);color:#c9a6ff;}
.nav-spacer{flex:1;}
.nav-footer{border-top:1px solid var(--border-soft);padding-top:12px;margin-top:8px;}

.topbar{
  display:flex;align-items:center;gap:14px;padding:16px 26px;border-bottom:1px solid var(--border-soft);
  position:sticky;top:0;background:rgba(20,16,25,0.72);backdrop-filter:blur(14px);z-index:20;
}
.search-wrap{flex:1;max-width:480px;position:relative;}
.search-wrap input{padding-left:38px;}
.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--text-faint);}
.main{padding:26px;max-width:1360px;}
@media(max-width:640px){.main{padding:16px;}.topbar{padding:12px 16px;}}

.page-title{font-size:26px;font-weight:600;margin:0 0 4px;}
.page-sub{color:var(--text-dim);font-size:14px;margin:0 0 22px;}

/* stat cards */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:26px;}
@media(max-width:1100px){.stats-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:560px){.stats-grid{grid-template-columns:1fr;}}
.stat-card{padding:18px 20px;animation:fadeUp .5s ease backwards;}
.stat-card .label{font-size:12.5px;color:var(--text-dim);font-weight:600;margin-bottom:9px;}
.stat-card .value{font-family:'Fraunces',serif;font-size:30px;font-weight:500;}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

.section-card{padding:20px 22px;margin-bottom:20px;}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.section-head h3{font-size:16px;font-weight:600;margin:0;font-family:'Manrope',sans-serif;}

table{width:100%;border-collapse:collapse;font-size:13.5px;}
th{text-align:left;color:var(--text-faint);font-weight:700;font-size:11.5px;letter-spacing:.03em;text-transform:uppercase;padding:0 12px 10px;border-bottom:1px solid var(--border-soft);}
td{padding:12px;border-bottom:1px solid var(--border-soft);vertical-align:middle;}
tr.row-click{cursor:pointer;transition:background .12s;}
tr.row-click:hover{background:rgba(255,255,255,0.035);}
.table-wrap{overflow-x:auto;}
.empty-state{padding:34px 10px;text-align:center;color:var(--text-faint);font-size:14px;}

.avatar{width:34px;height:34px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;flex-shrink:0;}
.avatar-sm{width:26px;height:26px;font-size:11px;}

.grid-2col{display:grid;grid-template-columns:1.15fr 0.85fr;gap:20px;}
@media(max-width:1000px){.grid-2col{grid-template-columns:1fr;}}

.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:18px;}
.toolbar .field-input{max-width:280px;}
select.field-input{cursor:pointer;}

.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px;}

.product-tile{overflow:hidden;transition:transform .15s;cursor:pointer;}
.product-tile:hover{transform:translateY(-3px);}
.product-tile .img{height:140px;background:linear-gradient(135deg,#2a2236,#241c30);display:flex;align-items:center;justify-content:center;color:var(--text-faint);font-size:12px;overflow:hidden;}
.product-tile .img img{width:100%;height:100%;object-fit:cover;}
.product-tile .body{padding:13px 14px;}
.product-tile .name{font-weight:700;font-size:14px;margin-bottom:4px;}
.product-tile .cat{font-size:11.5px;color:var(--text-faint);margin-bottom:8px;}
.product-tile .price{font-family:'Fraunces',serif;font-size:17px;}
.price-strike{text-decoration:line-through;color:var(--text-faint);font-size:12px;margin-left:6px;}

/* modal */
.modal-backdrop{position:fixed;inset:0;background:rgba(10,7,14,0.66);backdrop-filter:blur(3px);z-index:100;display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;animation:fadeIn .15s ease;}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.modal{width:100%;max-width:560px;background:var(--panel-solid);border:1px solid var(--border);border-radius:var(--radius-lg);padding:26px 26px 22px;animation:modalPop .18s cubic-bezier(.2,.9,.3,1.2);margin-bottom:40px;}
.modal.wide{max-width:720px;}
@keyframes modalPop{from{opacity:0;transform:translateY(10px) scale(0.98);}to{opacity:1;transform:translateY(0) scale(1);}}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
.modal-head h2{font-size:19px;margin:0;font-weight:600;}
.icon-btn{width:30px;height:30px;border-radius:8px;background:rgba(255,255,255,0.06);border:none;color:var(--text-dim);display:flex;align-items:center;justify-content:center;}
.icon-btn:hover{background:rgba(255,255,255,0.1);color:var(--text);}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px;border-top:1px solid var(--border-soft);padding-top:16px;}
.form-divider{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-faint);font-weight:700;margin:18px 0 10px;}

.toast-wrap{position:fixed;bottom:22px;right:22px;z-index:200;display:flex;flex-direction:column;gap:8px;}
.toast{background:var(--panel-solid);border:1px solid var(--border);padding:12px 16px;border-radius:12px;font-size:13.5px;font-weight:600;box-shadow:0 12px 30px -10px rgba(0,0,0,0.5);animation:toastIn .2s ease;display:flex;align-items:center;gap:8px;}
@keyframes toastIn{from{opacity:0;transform:translateX(16px);}to{opacity:1;transform:translateX(0);}}

.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}
.login-card{width:100%;max-width:400px;padding:34px 30px;}
.login-logo{width:52px;height:52px;border-radius:15px;background:var(--grad);display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:24px;color:#fff;margin-bottom:18px;}

.activity-item{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--border-soft);}
.activity-item:last-child{border-bottom:none;}
.activity-dot{width:32px;height:32px;border-radius:9px;background:rgba(157,92,255,0.14);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#c9a6ff;}
.activity-item .t{font-size:13.5px;font-weight:600;}
.activity-item .d{font-size:12.5px;color:var(--text-dim);margin-top:2px;}
.activity-item .ts{font-size:11px;color:var(--text-faint);margin-top:3px;}

.profile-header{display:flex;gap:16px;align-items:center;margin-bottom:6px;}
.profile-header .avatar{width:56px;height:56px;font-size:20px;}
.kv-row{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--border-soft);font-size:13.5px;}
.kv-row:last-child{border-bottom:none;}
.kv-row .k{color:var(--text-dim);}
.kv-row .v{font-weight:600;text-align:right;}

.stepper{display:flex;align-items:center;flex-wrap:wrap;gap:0;}
.step{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--text-faint);padding:5px 10px;border-radius:99px;border:1px solid var(--border-soft);}
.step.done{color:var(--success);border-color:rgba(61,220,151,0.3);background:rgba(61,220,151,0.08);}
.step.now{color:#fff;background:var(--grad);border-color:transparent;font-weight:700;}
.step-sep{width:14px;height:1px;background:var(--border);margin:0 2px;}

.line-item-row{display:grid;grid-template-columns:2fr 0.7fr 0.9fr 0.9fr auto;gap:8px;align-items:end;margin-bottom:10px;}
@media(max-width:640px){.line-item-row{grid-template-columns:1fr 1fr;}}

.tab-row{display:flex;gap:6px;margin-bottom:16px;border-bottom:1px solid var(--border-soft);}
.tab-btn{padding:9px 4px;margin-right:16px;font-size:13.5px;font-weight:700;color:var(--text-faint);border-bottom:2px solid transparent;background:none;border-top:none;border-left:none;border-right:none;}
.tab-btn.active{color:var(--text);border-bottom-color:var(--purple);}

.search-results{position:absolute;top:calc(100% + 8px);left:0;right:0;background:var(--panel-solid);border:1px solid var(--border);border-radius:14px;padding:8px;max-height:420px;overflow-y:auto;box-shadow:0 20px 50px -12px rgba(0,0,0,0.6);z-index:60;}
.search-cat{font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-faint);font-weight:700;padding:8px 10px 4px;}
.search-res-item{display:flex;justify-content:space-between;padding:9px 10px;border-radius:9px;font-size:13.5px;cursor:pointer;}
.search-res-item:hover{background:rgba(255,255,255,0.06);}
.search-res-item .m{color:var(--text-faint);font-size:12px;}

.mobile-nav-toggle{display:none;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--text);width:36px;height:36px;border-radius:9px;align-items:center;justify-content:center;}
@media(max-width:900px){.mobile-nav-toggle{display:flex;}}
.hint{font-size:12px;color:var(--text-faint);margin-top:5px;}
.notes-box{white-space:pre-wrap;font-size:13.5px;line-height:1.55;color:var(--text-dim);}
</style>
</head>
<body>
<div id="app"></div>
<div class="toast-wrap" id="toastWrap"></div>

<script>
/* ---------------------------------------------------------------- */
/* STORAGE HELPERS                                                   */
/* ---------------------------------------------------------------- */
const K = { owner:'owner-config', customers:'customers', products:'products', orders:'orders', logs:'activity-log' };

async function loadKey(key, fallback){
  try{ const r = await window.storage.get(key, false); return r ? JSON.parse(r.value) : fallback; }
  catch(e){ return fallback; }
}
async function saveKey(key, value){
  try{ await window.storage.set(key, JSON.stringify(value), false); return true; }
  catch(e){ console.error('storage save failed', key, e); return false; }
}

/* ---------------------------------------------------------------- */
/* APP STATE + INIT                                                  */
/* ---------------------------------------------------------------- */
const app = {
  state:{
    view:'loading', session:false, ownerConfig:null,
    customers:[], products:[], orders:[], logs:[],
    selectedCustomerId:null, selectedProductId:null,
    custSearch:'', custFilter:'newest',
    prodSearch:'', prodFilter:'all',
    orderFilterStatus:'all', orderFilterPay:'all',
    logSearch:'',
    searchQuery:'', searchOpen:false,
    mobileNavOpen:false,
    loginError:'', setupError:'',
  },

  async init(){
    const [owner, customers, products, orders, logs] = await Promise.all([
      loadKey(K.owner, null), loadKey(K.customers, []), loadKey(K.products, []),
      loadKey(K.orders, []), loadKey(K.logs, []),
    ]);
    this.state.ownerConfig = owner;
    this.state.customers = customers;
    this.state.products = products;
    this.state.orders = orders;
    this.state.logs = logs;
    this.state.view = owner ? 'login' : 'setup';
    this.render();
  },

  toast(msg, kind){
    const wrap = document.getElementById('toastWrap');
    const el = document.createElement('div');
    el.className = 'toast';
    const color = kind==='error' ? 'var(--danger)' : kind==='warn' ? 'var(--warning)' : 'var(--success)';
    el.innerHTML = `<span class="dot" style="color:${color}"></span><span>${esc(msg)}</span>`;
    wrap.appendChild(el);
    setTimeout(()=>{ el.style.opacity='0'; el.style.transform='translateX(16px)'; el.style.transition='all .2s'; setTimeout(()=>el.remove(),200); }, 2600);
  },

  logActivity(action, description, opts){
    opts = opts || {};
    const entry = {
      id: genId('LOG'),
      dateTime: new Date().toISOString(),
      action, description,
      customerId: opts.customerId || null,
      customerName: opts.customerName || null,
      productId: opts.productId || null,
      productName: opts.productName || null,
      orderId: opts.orderId || null,
    };
    this.state.logs.unshift(entry);
    saveKey(K.logs, this.state.logs);
  },

  go(view, extra){
    this.state.view = view;
    this.state.searchOpen = false;
    this.state.mobileNavOpen = false;
    if(extra) Object.assign(this.state, extra);
    window.scrollTo(0,0);
    this.render();
  },

  render(){
    const s = this.state;
    let html = '';
    if(s.view==='loading') html = `<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;color:var(--text-faint);">Loading…</div>`;
    else if(s.view==='setup') html = viewSetup();
    else if(s.view==='login') html = viewLogin();
    else html = shell(viewFor(s.view));
    document.getElementById('app').innerHTML = html;
    afterRender();
  },
};
window.app = app;

/* ---------------------------------------------------------------- */
/* UTIL                                                               */
/* ---------------------------------------------------------------- */
function esc(str){
  if(str===undefined||str===null) return '';
  return String(str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function genId(prefix){
  const n = Math.floor(1000 + Math.random()*9000);
  return `${prefix}-${Date.now().toString().slice(-5)}${n}`;
}
function money(n){
  n = Number(n)||0;
  return '₹' + n.toLocaleString('en-IN', {maximumFractionDigits:0});
}
function fmtDate(iso){
  if(!iso) return '—';
  const d = new Date(iso);
  if(isNaN(d)) return '—';
  return d.toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'});
}
function fmtDateTime(iso){
  const d = new Date(iso);
  if(isNaN(d)) return '—';
  return d.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) + ' • ' + d.toLocaleTimeString('en-IN',{hour:'numeric',minute:'2-digit'});
}
function initials(name){
  if(!name) return '?';
  return name.trim().split(/\s+/).slice(0,2).map(p=>p[0]).join('').toUpperCase();
}
function statusClass(prefix, status){
  return prefix + '-' + String(status).toLowerCase().replace(/\s+/g,'');
}
function todayISO(){ return new Date().toISOString(); }

function customerById(id){ return app.state.customers.find(c=>c.id===id); }
function productById(id){ return app.state.products.find(p=>p.id===id); }
function ordersForCustomer(id){ return app.state.orders.filter(o=>o.customerId===id).sort((a,b)=>new Date(b.orderDate)-new Date(a.orderDate)); }
function ordersForProduct(id){ return app.state.orders.filter(o=>o.items.some(it=>it.productId===id)).sort((a,b)=>new Date(b.orderDate)-new Date(a.orderDate)); }

function customerStats(id){
  const orders = ordersForCustomer(id);
  const totalOrders = orders.length;
  const totalSpent = orders.reduce((s,o)=> s + (o.paymentStatus==='Refunded' ? 0 : o.amountPaid), 0);
  const pending = orders.filter(o=>!['Delivered','Cancelled','Returned'].includes(o.orderStatus)).length;
  const unpaid = orders.reduce((s,o)=> s + (o.total - o.amountPaid), 0);
  const sorted = [...orders].sort((a,b)=>new Date(a.orderDate)-new Date(b.orderDate));
  return {
    totalOrders, totalSpent, pending, unpaid: Math.max(0,unpaid),
    firstPurchase: sorted[0]?.orderDate || null,
    lastPurchase: sorted[sorted.length-1]?.orderDate || null,
  };
}
function productStats(id){
  const orders = ordersForProduct(id);
  let unitsSold=0, revenue=0;
  const customerSet = new Set();
  orders.forEach(o=>{
    o.items.filter(it=>it.productId===id).forEach(it=>{
      unitsSold += it.qty;
      revenue += it.qty*it.price;
    });
    customerSet.add(o.customerId);
  });
  return { unitsSold, revenue, customerCount: customerSet.size, orderCount: orders.length };
}
function orderTotal(order){
  const itemsSum = order.items.reduce((s,it)=> s + it.qty*it.price, 0);
  return Math.max(0, itemsSum - (Number(order.discount)||0) + (Number(order.deliveryCharge)||0));
}
function computeProductStatus(stock){
  if(stock<=0) return 'Out of Stock';
  if(stock<=5) return 'Low Stock';
  return 'Available';
}

