const handlers = {
  async setupOwner(e){
    e.preventDefault();
    const f = e.target;
    const cfg = { storeName: f.storeName.value.trim(), username: f.username.value.trim(), password: f.password.value };
    if(!cfg.storeName || !cfg.username || !cfg.password){ app.state.setupError='All fields are required.'; app.render(); return false; }
    app.state.ownerConfig = cfg;
    await saveKey(K.owner, cfg);
    app.state.setupError='';
    app.state.session = true;
    app.go('dashboard');
    app.toast('Owner account created');
    return false;
  },
  async login(e){
    e.preventDefault();
    const f = e.target;
    const cfg = app.state.ownerConfig;
    if(cfg && f.username.value.trim()===cfg.username && f.password.value===cfg.password){
      app.state.session = true;
      app.state.loginError='';
      app.go('dashboard');
      app.toast('Welcome back');
    } else {
      app.state.loginError = 'Incorrect username or password.';
      app.render();
    }
    return false;
  },
  logout(){
    app.state.session = false;
    app.go('login');
    app.toast('Logged out');
  },
  toggleNav(){ app.state.mobileNavOpen = !app.state.mobileNavOpen; app.render(); },

  globalSearch(v){ app.state.searchQuery = v; app.state.searchOpen = true; app.render();
    // restore focus + caret after re-render
    const el = document.querySelector('.search-wrap input');
    if(el){ el.focus(); el.setSelectionRange(v.length, v.length); }
  },

  setCustSearch(v){ app.state.custSearch = v; app.render(); const el=document.querySelector('.toolbar .field-input'); if(el){el.focus(); el.setSelectionRange(v.length,v.length);} },
  setCustFilter(v){ app.state.custFilter = v; app.render(); },
  setProdSearch(v){ app.state.prodSearch = v; app.render(); const el=document.querySelector('.toolbar .field-input'); if(el){el.focus(); el.setSelectionRange(v.length,v.length);} },
  setProdFilter(v){ app.state.prodFilter = v; app.render(); },
  setOrderFilterStatus(v){ app.state.orderFilterStatus = v; app.render(); },
  setOrderFilterPay(v){ app.state.orderFilterPay = v; app.render(); },
  setLogSearch(v){ app.state.logSearch = v; app.render(); const el=document.querySelector('.toolbar .field-input'); if(el){el.focus(); el.setSelectionRange(v.length,v.length);} },

  async submitCustomer(e, id){
    e.preventDefault();
    const f = e.target;
    const data = {
      name: f.name.value.trim(), instagram: f.instagram.value.trim(), phone: f.phone.value.trim(),
      email: f.email.value.trim(), notes: f.notes.value.trim(),
      address: { house:f.house.value.trim(), street:f.street.value.trim(), area:f.area.value.trim(), city:f.city.value.trim(), district:f.district.value.trim(), state:f.state.value.trim(), pin:f.pin.value.trim(), country:f.country.value.trim() },
    };
    if(id){
      const c = customerById(id);
      Object.assign(c, data);
      app.logActivity('Customer edited', `${data.name}'s details were updated`, {customerId:id, customerName:data.name});
      app.toast('Customer updated');
    } else {
      const newC = { id: genId('CUST'), dateAdded: todayISO(), ...data };
      app.state.customers.push(newC);
      app.logActivity('Customer added', `${data.name} was added as a new customer`, {customerId:newC.id, customerName:data.name});
      app.toast('Customer added');
    }
    await saveKey(K.customers, app.state.customers);
    modals.close();
    app.render();
    return false;
  },
  async submitNotes(e, id){
    e.preventDefault();
    const c = customerById(id);
    c.notes = e.target.notes.value.trim();
    await saveKey(K.customers, app.state.customers);
    app.logActivity('Customer edited', `Notes updated for ${c.name}`, {customerId:id, customerName:c.name});
    modals.close();
    app.render();
    app.toast('Notes saved');
    return false;
  },
  async deleteCustomer(id){
    const c = customerById(id);
    if(!confirm(`Delete ${c.name}? This cannot be undone. Their order history will remain but will show as an unlinked customer.`)) return;
    app.state.customers = app.state.customers.filter(x=>x.id!==id);
    await saveKey(K.customers, app.state.customers);
    app.logActivity('Customer edited', `${c.name} was deleted`, {customerName:c.name});
    app.render();
    app.toast('Customer deleted');
  },

  async submitProduct(e, id){
    e.preventDefault();
    const f = e.target;
    const stock = Number(f.stock.value)||0;
    const data = {
      name: f.name.value.trim(), category: f.category.value.trim(), image: f.image.value.trim(),
      description: f.description.value.trim(), sellingPrice: Number(f.sellingPrice.value)||0,
      originalPrice: Number(f.originalPrice.value)||0, discount: Number(f.discount.value)||0,
      stock, size: f.size.value.trim(), color: f.color.value.trim(), notes: f.notes.value.trim(),
      status: computeProductStatus(stock),
    };
    if(id){
      const p = productById(id);
      Object.assign(p, data);
      app.logActivity('Product edited', `${data.name} was updated`, {productId:id, productName:data.name});
      app.toast('Product updated');
    } else {
      const newP = { id: genId('PROD'), dateAdded: todayISO(), ...data };
      app.state.products.push(newP);
      app.logActivity('Product added', `${data.name} was added to the catalog`, {productId:newP.id, productName:data.name});
      app.toast('Product added');
    }
    await saveKey(K.products, app.state.products);
    modals.close();
    app.render();
    return false;
  },
  async deleteProduct(id){
    const p = productById(id);
    if(!confirm(`Delete ${p.name}? Past orders will keep a record of the product name.`)) return;
    app.state.products = app.state.products.filter(x=>x.id!==id);
    await saveKey(K.products, app.state.products);
    app.logActivity('Product edited', `${p.name} was deleted`, {productName:p.name});
    app.render();
    app.toast('Product deleted');
  },

  lineProductChange(sel){
    const row = sel.closest('.line-item-row');
    const p = productById(sel.value);
    if(p) row.querySelector('.line-price').value = p.sellingPrice;
    orderCalc();
  },
  addLineItem(){
    const wrap = document.getElementById('lineItems');
    const i = wrap.children.length;
    const prodOptionsFor = (selId)=> app.state.products.map(p=>`<option value="${p.id}">${esc(p.name)} (${money(p.sellingPrice)}, stock ${p.stock})</option>`).join('');
    const div = document.createElement('div');
    div.innerHTML = lineItemRow({productId:'',qty:1,price:0}, i, prodOptionsFor);
    wrap.appendChild(div.firstElementChild);
  },
  removeLineItem(btn){
    const rows = document.querySelectorAll('#lineItems .line-item-row');
    if(rows.length<=1) return;
    btn.closest('.line-item-row').remove();
    orderCalc();
  },

  async submitOrder(e, id){
    e.preventDefault();
    const f = e.target;
    const customerId = f.customerId.value;
    if(!customerId){ app.toast('Please select a customer','error'); return false; }
    const rows = document.querySelectorAll('#lineItems .line-item-row');
    const items = [];
    let invalid = false;
    rows.forEach(r=>{
      const pid = r.querySelector('.line-product').value;
      const qty = Number(r.querySelector('.line-qty').value)||0;
      const price = Number(r.querySelector('.line-price').value)||0;
      if(!pid || qty<=0){ invalid = true; return; }
      const prod = productById(pid);
      items.push({ productId: pid, name: prod?prod.name:'Product', qty, price });
    });
    if(invalid || !items.length){ app.toast('Select a product and quantity for every line','error'); return false; }

    const discount = Number(f.discount.value)||0;
    const deliveryCharge = Number(f.deliveryCharge.value)||0;
    const itemsSum = items.reduce((s,it)=>s+it.qty*it.price,0);
    const total = Math.max(0, itemsSum - discount + deliveryCharge);
    const paymentStatus = f.paymentStatus.value;
    let amountPaid = Number(f.amountPaid.value)||0;
    if(paymentStatus==='Paid') amountPaid = total;
    if(paymentStatus==='Unpaid') amountPaid = 0;

    const existing = id ? app.state.orders.find(o=>o.id===id) : null;

    // stock adjustment: restore old items' stock, then deduct new items' stock
    if(existing){
      existing.items.forEach(it=>{ const p = productById(it.productId); if(p) p.stock += it.qty; });
    }
    items.forEach(it=>{ const p = productById(it.productId); if(p){ p.stock = Math.max(0, p.stock - it.qty); p.status = computeProductStatus(p.stock); } });

    const orderData = {
      customerId, items, discount, deliveryCharge, total,
      orderDate: new Date(f.orderDate.value).toISOString(),
      paymentMethod: f.paymentMethod.value, paymentStatus, amountPaid,
      amountRemaining: Math.max(0,total-amountPaid),
      orderStatus: f.orderStatus.value, courier: f.courier.value.trim(),
      trackingNumber: f.trackingNumber.value.trim(),
      expectedDelivery: f.expectedDelivery.value ? new Date(f.expectedDelivery.value).toISOString() : null,
      deliveredDate: f.deliveredDate.value ? new Date(f.deliveredDate.value).toISOString() : null,
    };

    const c = customerById(customerId);
    if(existing){
      Object.assign(existing, orderData);
      app.logActivity('Order updated', `${c?c.name:'Customer'}'s order ${existing.id} was updated — ${orderData.orderStatus}, ${orderData.paymentStatus}`, {customerId, customerName:c?.name, orderId:existing.id});
      app.toast('Order updated');
    } else {
      const newO = { id: genId('ORD'), ...orderData };
      app.state.orders.push(newO);
      app.logActivity('New Order', `${c?c.name:'Customer'} purchased ${items.map(it=>it.name+' × '+it.qty).join(', ')}`, {customerId, customerName:c?.name, orderId:newO.id});
      app.toast('Order created');
    }
    await Promise.all([saveKey(K.orders, app.state.orders), saveKey(K.products, app.state.products)]);
    modals.close();
    app.render();
    return false;
  },
  async deleteOrder(id){
    const o = app.state.orders.find(x=>x.id===id);
    if(!o) return;
    if(!confirm(`Delete order ${o.id}? Stock will be restored.`)) return;
    o.items.forEach(it=>{ const p = productById(it.productId); if(p){ p.stock += it.qty; p.status = computeProductStatus(p.stock); } });
    app.state.orders = app.state.orders.filter(x=>x.id!==id);
    await Promise.all([saveKey(K.orders, app.state.orders), saveKey(K.products, app.state.products)]);
    const c = customerById(o.customerId);
    app.logActivity('Order updated', `Order ${o.id} was deleted`, {customerId:o.customerId, customerName:c?.name, orderId:o.id});
    app.render();
    app.toast('Order deleted');
  },
};

function afterRender(){
  document.addEventListener('click', closeSearchOnOutsideClick, {once:true});
}
function closeSearchOnOutsideClick(e){
  if(!app.state.searchOpen) return;
  const wrap = document.querySelector('.search-wrap');
  if(wrap && !wrap.contains(e.target)){ app.state.searchOpen=false; app.render(); }
  else document.addEventListener('click', closeSearchOnOutsideClick, {once:true});
}

app.init();
</script>
